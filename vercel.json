{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/build/preview/(.*)",
      "has": [{ "type": "host", "value": "preview.lumine.app" }],
      "destination": "https://api.twinkle.network/build/preview/$1"
    },
    {
      "source": "/build/preview/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^b-[0-9]+\\.preview\\.lumine\\.app$"
        }
      ],
      "destination": "https://api.twinkle.network/build/preview/$1"
    },
    {
      "source": "/build/vendor/(.*)",
      "destination": "https://api.twinkle.network/build/vendor/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        { "type": "host", "value": "^(www\\.)?lumine\\.network$" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|kakaotalk-scrap|LinkedInBot|WhatsApp|TelegramBot|Pinterestbot|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "https://api.twinkle.network/share-page/$1?brand=lumine"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|kakaotalk-scrap|LinkedInBot|WhatsApp|TelegramBot|Pinterestbot|redditbot|SkypeUriPreview).*"
        }
      ],
      "destination": "https://api.twinkle.network/share-page/$1?brand=twinkle"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [{ "type": "host", "value": "^(www\\.)?lumine\\.network$" }],
      "destination": "/lumine.html"
    },
    { "source": "/((?!assets/).*)", "destination": "/twinkle.html" }
  ]
}
